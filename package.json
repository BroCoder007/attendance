{
  "name": "rollcall",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env build",
    "test": "node --test tests/*.test.js",
    "account": "node --env-file-if-exists=.env scripts/account.js",
    "setup": "node scripts/setup.js",
    "demo": "node --env-file-if-exists=.env scripts/demo.js",
    "test:http": "node --test tests/http.integration.js",
    "format": "prettier --write \"src/**/*.{js,svelte,css,html}\" \"scripts/*.js\" \"tests/*.js\" vite.config.js"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "ipaddr.js": "^2.2.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "typescript": "^6.0.0",
    "vite": "^8.0.12"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
